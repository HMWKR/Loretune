--- studio.css before
+++ studio.css current
@@ -116,6 +116,19 @@
 .clip-row button { padding:2px; }
 .lt-ui .clip-row .clip-field { min-width:0; margin:0; font-size:inherit; }
 .clip-field-name { display:none; }
+.lt-ui .clip-overlay { margin:0 0 var(--ui-space-3); padding:var(--ui-space-2) 0; border-bottom:1px solid var(--ui-line); }
+.lt-ui .clip-overlay>summary { min-height:var(--ui-control-min); padding:var(--ui-space-2) 0; color:var(--ui-body); overflow-wrap:anywhere; }
+.lt-ui .clip-overlay>summary span { margin-inline-start:var(--ui-space-2); color:var(--ui-muted); font-size:var(--ui-meta); }
+.lt-ui .clip-overlay label { min-width:0; margin:var(--ui-space-2) 0; }
+.lt-ui .clip-overlay-fields { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--ui-space-2) var(--ui-space-3); }
+.lt-ui .clip-overlay :is(input,select),.lt-ui .timeline-frame-preview :is(input,select) { font-variant-numeric:tabular-nums; }
+.lt-ui .clip-overlay p,.lt-ui .timeline-frame-preview p { line-height:1.6; overflow-wrap:anywhere; }
+.lt-ui .timeline-frame-preview { margin:var(--ui-space-3) 0; padding:var(--ui-space-3) 0; border-top:1px solid var(--ui-line); border-bottom:1px solid var(--ui-line); }
+.lt-ui .timeline-frame-preview .row { flex-wrap:wrap; align-items:end; }
+.lt-ui .timeline-frame-preview .row>label { flex:1 1 10rem; }
+.lt-ui .timeline-frame-preview button { flex:0 1 auto; }
+.lt-ui #timelineFrameImage { display:block; width:100%; max-height:360px; object-fit:contain; background:var(--ui-media); }
+.lt-ui #timelineFrameImage[hidden] { display:none; }
 .track { display:flex; height:28px; gap:2px; margin:var(--ui-space-3) 0; background:var(--ui-media); }
 .track span { display:flex; align-items:center; background:var(--ui-line); border:1px solid var(--ui-control); padding:3px; overflow:hidden; white-space:nowrap; font-size:var(--ui-meta); }
 .caption-row { display:grid; grid-template-columns:65px 65px minmax(0,1fr) var(--ui-control-min); gap:5px; margin:6px 0; }
