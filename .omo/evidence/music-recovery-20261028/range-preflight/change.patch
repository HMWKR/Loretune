+class MusicRangePreflightTest(unittest.TestCase):
+    def project(self, start=3, end=4, offset=3, duration=3):
+        timeline=dict(id=1,clips=[dict(shot='s',take=1,duration=duration,trim=0)],
+                      audio=1,audio_offset=offset,subtitles=[],profile='preview',
+                      approval=dict(selected_take_snapshot={'s':1}))
+        project=dict(timeline_versions=[timeline],timeline_head=1,
+                     audio_versions=[dict(id=1,metadata=dict(duration=10))],audio_selected=1,
+                     music_versions=[dict(id=1,audio=1,start=start,end=end)],music_head=1,
+                     shots={'s':dict(selected=1,takes=[dict(id=1)],
+                                     reviews=[dict(take=1,decision='approved')])})
+        current(project)
+        return project
+
+    def inspect(self, project):
+        before=deepcopy(project)
+        result=preflight(project)
+        self.assertEqual(project,before)
+        return result,[w for w in result['warnings'] if w.startswith('현재 음악 선택')]
+
+    def test_short_long_and_shifted_output_describe_both_ranges_without_blocking(self):
+        for start,end,offset,duration in [(3,4,3,3),(3,7,3,3),(3,6,2,3),(3,6,4,3)]:
+            with self.subTest(start=start,end=end,offset=offset,duration=duration):
+                result,warnings=self.inspect(self.project(start,end,offset,duration))
+                self.assertTrue(result['ready']);self.assertEqual(result['errors'],[])
+                self.assertEqual(len(warnings),1)
+                self.assertIn(f'현재 음악 선택 {start:.3f}–{end:.3f}초',warnings[0])
+                self.assertIn(f'이 편집의 음원 출력 {offset:.3f}–{offset+duration:.3f}초',warnings[0])
+                self.assertIn('편집의 음원 시작과 컷 길이를 확인하세요.',warnings[0])
+                self.assertEqual((result['audio_start'],result['audio_end']),(offset,offset+duration))
+
