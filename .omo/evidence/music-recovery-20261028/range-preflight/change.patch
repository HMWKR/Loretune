+        for start,end,offset,duration in [(3,6,3,3),(.1,.3,.1,.2),(.1,.55,.1,.45)]:
+            with self.subTest(start=start,end=end):
+                result,warnings=self.inspect(self.project(start,end,offset,duration))
+                self.assertTrue(result['ready']);self.assertEqual(warnings,[])
+        project=self.project(.1,.55,.1,.2)
