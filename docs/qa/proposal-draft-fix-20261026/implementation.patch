+ const name=song(),scope=JSON.stringify([state?.workspace_id,state?.project_ids?.[name],name,project()?.ip]);
+ if(scope!==proposalFormScope){proposalFormScope=scope;proposalFormEpoch++}
+ return JSON.stringify([scope,proposalFormEpoch]);
+}
+for(const id of ['preferenceForm','chatForm']){
+ const form=$('#'+id);
