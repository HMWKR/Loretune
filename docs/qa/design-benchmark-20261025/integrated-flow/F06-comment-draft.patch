 function drawComparison(){const sh=project()?.shots[shotName];for(const side of ['Left','Right']){const t=sh?.takes.find(t=>t.id===Number($('#compare'+side).value));const target=$('#compare'+side+'Preview');if(!t){target.textContent='take 없음';continue}const review=[...(sh.reviews||[])].reverse().find(r=>r.take===t.id);target.innerHTML=`<p>T${t.id} · ${sh.selected===t.id?'현재 선택':'미선택'} · ${esc(({approved:'승인됨',rejected:'거절',changes_requested:'수정 요청'})[review?.decision]||'검토 대기')}</p>${image(t)?`<img style="width:100%" src="${asset(t)}" alt="비교 T${t.id}">`:`<video style="width:100%" src="${asset(t)}" controls></video>`}<p>${esc(t.reason)}</p><small>${esc(t.sha256)}</small>`}}
 $('#compareButton').onclick=()=>{const sh=project()?.shots[shotName];if(!sh?.takes.length)return message('비교할 take를 먼저 연결하세요.',true);for(const side of ['Left','Right'])$('#compare'+side).innerHTML=sh.takes.map(t=>`<option value="${t.id}">T${t.id}</option>`).join('');$('#compareLeft').value=sh.selected||sh.takes[0].id;$('#compareRight').value=sh.takes.at(-1).id;drawComparison();$('#compareDialog').showModal()};$('#compareLeft').onchange=drawComparison;$('#compareRight').onchange=drawComparison;
