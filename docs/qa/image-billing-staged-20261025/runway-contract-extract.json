              "estimatedCost"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    "400": {
      "description": "The request was rejected. Inspect `error` or `issues` (when present) and retry with a corrected request.",
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "error": {
                "description": "A message describing why the request was rejected.",
                "type": "string"
              },
              "issues": {
                "description": "Field-level validation issues when the request failed Zod body/query validation. Omitted for other 400s.",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "description": "A machine-readable issue code from request validation.",
                      "type": "string"
                    },
                    "path": {
                      "description": "The path to the invalid field in the request body or query.",
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          }
                        ]
                      }
                    },
                    "message": {
                      "description": "A human-readable description of the issue.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "path",
                    "message"
                  ],
                  "additionalProperties": {}
                }
              },
              "reason": {
                "description": "A machine-readable rejection reason when one applies — e.g. DEPRECATED_MODEL when the requested model has reached its sunset date.",
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^SAFETY\\.(INPUT|OUTPUT)\\.(TEXT|IMAGE|VIDEO|AUDIO|AVATAR)$"
                  },
                  {
                    "type": "string",
                    "const": "SAFETY.INPUT.PUBLIC_FIGURE"
                  },
                  {
                    "type": "string",
                    "const": "SAFETY.INPUT.MULTIMODAL"
                  },
                  {
                    "type": "string",
                    "const": "SAFETY.OUTPUT.MULTIMODAL"
                  },
                  {
                    "type": "string",
                    "const": "SAFETY.INPUT.THIRD_PARTY"
                  },
                  {
                    "type": "string",
                    "const": "SAFETY.OUTPUT.THIRD_PARTY"
                  },
                  {
                    "type": "string",
                    "const": "INPUT_PREPROCESSING.SAFETY.THIRD_PARTY"
                  },
                  {
                    "type": "string",
                    "const": "DEPRECATED_MODEL.THIRD_PARTY"
                  },
                  {
                    "type": "string",
                    "const": "DEPRECATED_MODEL"
                  },
                  {
                    "type": "string",
                    "pattern": "^INTERNAL\\.BAD_OUTPUT\\.(CODE01|CODE02|CODE03|CODE04|CODE05)$"
                  },
                  {
                    "type": "string",
                    "pattern": "^INPUT_PREPROCESSING\\.SAFETY\\.(TEXT|IMAGE|VIDEO)$"
                  },
                  {
                    "type": "string",
                    "const": "INPUT_PREPROCESSING.INTERNAL"
                  },
                  {
                    "type": "string",
                    "const": "INPUT_PREPROCESSING.VALIDATION"
                  },
                  {
                    "type": "string",
                    "const": "INPUT_VALIDATION.VIDEO.TOO_MANY_SHOTS"
                  },
                  {
                    "type": "string",
                    "const": "INPUT_VALIDATION.VIDEO.UNSUPPORTED_FPS"
                  },
                  {
                    "type": "string",
                    "const": "INPUT_VALIDATION.VIDEO.HDR_SOURCE"
                  },
                  {
                    "type": "string",
                    "const": "ASSET.MISSING"
                  },
                  {
                    "type": "string",
                    "const": "ASSET.INVALID"
                  },
                  {
                    "type": "string",
                    "const": "SANDBOX.WORKSPACE_LIMIT"
                  },
                  {
                    "type": "string",
                    "const": "SANDBOX.CONTAINER_LOST"
                  },
                  {
                    "type": "string",
                    "const": "SANDBOX.NOT_RESUMABLE"
                  },
                  {
                    "type": "string",
                    "const": "FORBIDDEN"
                  },
                  {
                    "type": "string",
                    "const": "QUOTA"
                  },
                  {
                    "type": "string",
                    "pattern": "^THIRD_PARTY\\.(INPUT_VALIDATION|OUTPUT_VALIDATION|RATE_LIMITED|TIMEOUT|UNAVAILABLE)$"
                  },
                  {
                    "type": "string",
                    "const": "INTERNAL.TIMEOUT"
                  },
                  {
                    "type": "string",
                    "const": "INTERNAL.HDR_COMPOSE"
                  },
                  {
                    "type": "string",
                    "const": "INTERNAL"
                  },
                  {
                    "type": "string",
                    "const": "UNKNOWN"
                  }
                ]
              },
              "docUrl": {
                "description": "A link to the public API documentation.",
                "type": "string"
              }
            },
            "required": [
              "error"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    "429": {
      "description": "You have exceeded the rate limit for this endpoint.",
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              }
            },
            "required": [
              "error"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  }
}