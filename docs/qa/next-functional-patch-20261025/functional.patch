+class UsageJournal:
+ """Shared with earlier approved synthetic trials; unknowns retain reservations."""
+ def __init__(self,path,mode='anthropic-live'):
+  self.path=path;self.mode=mode
+ def reserve(self,identifier,digest,turn,held,turn_cap):
